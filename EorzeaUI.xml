<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- Party row button (elements/partyList.lua), which sets its width from the style and height by snippet. -->
    <Button name="EorzeaUIPartyButtonTemplate" virtual="true" inherits="SecureUnitButtonTemplate">
        <Size x="410" y="46"/>
        <Attributes>
            <Attribute name="type1" type="string" value="target"/>
            <Attribute name="type2" type="string" value="togglemenu"/>
        </Attributes>
    </Button>
    <!-- Raid cell (elements/raidList.lua), created by each group's SecureGroupHeader. -->
    <Button name="EorzeaUIRaidButtonTemplate" virtual="true" inherits="SecureUnitButtonTemplate">
        <Size x="168" y="45"/>
        <Attributes>
            <Attribute name="type1" type="string" value="target"/>
            <Attribute name="type2" type="string" value="togglemenu"/>
        </Attributes>
    </Button>
    <!-- Raid pet row (elements/raidPets.lua), created by the pet SecureGroupPetHeader. -->
    <Button name="EorzeaUIRaidPetButtonTemplate" virtual="true" inherits="SecureUnitButtonTemplate">
        <Size x="168" y="32"/>
        <Attributes>
            <Attribute name="type1" type="string" value="target"/>
            <Attribute name="type2" type="string" value="togglemenu"/>
        </Attributes>
    </Button>
</Ui>
